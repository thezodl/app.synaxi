# Copy to .env.local for `bun dev`. Real values live in Vercel env (prod) — never commit them.

# Auth0 Regular Web Application
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Paste the OUTPUT of `openssl rand -hex 32` (64 hex chars). Use a different value than prod.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Auth0 API identifier (the `aud` of access tokens)
AUTH0_AUDIENCE=https://synaxi.app/api

# Neon (dev branch for local work). Pooled for the app, unpooled for drizzle-kit migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Feed URL encryption: paste the OUTPUT of `openssl rand -base64 32`. Different per environment;
# changing it makes stored feed URLs unreadable (re-import OPML).
FEED_URL_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/retention.
CRON_SECRET=
